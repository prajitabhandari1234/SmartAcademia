<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF4FF"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/unitDetailTitleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#0B5FA5"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/gradeProgressTitleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/grade_progress_title"
        android:textColor="#0B5FA5"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/unitProgressTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#DDE6F2"
        android:padding="12dp"
        android:textColor="#111111"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/unitPassStatusTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#DDE6F2"
        android:padding="12dp"
        android:textColor="#0B5FA5"
        android:textSize="15sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/addAssignmentButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:text="@string/add_assignment_title"
        android:textAllCaps="false" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/unitAssignmentRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/backFromUnitButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:backgroundTint="#616161"
        android:text="@string/cancel_button"
        android:textColor="#FFFFFF"
        android:textAllCaps="false" />

</LinearLayout>