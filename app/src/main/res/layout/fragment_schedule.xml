<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF4FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/smart_schedule"
            android:textColor="#0B5FA5"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dateTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#0B5FA5"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <Button
                android:id="@+id/dayButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/day"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/weekButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/week"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <Button
            android:id="@+id/previousWeekButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/previous_week_arrow"
            android:textColor="#FFFFFF"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/weekRangeTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#0B5FA5"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/nextWeekButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/next_week_arrow"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:id="@+id/weekDaysLayout"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#FFFFFF"
            android:layout_marginTop="14dp">

            <TextView
                android:id="@+id/sunTextView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/sun"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/monTextView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/mon"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tueTextView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tue"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wedTextView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/wed"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/thuTextView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/thu"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/friTextView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/fri"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/satTextView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/sat"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/timelineLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/regenerateButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/regenerate_today_plan"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="18dp" />

    </LinearLayout>
</ScrollView>