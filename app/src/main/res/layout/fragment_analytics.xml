<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF4FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Analytics"
            android:textColor="#0B5FA5"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/analyticsDateTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#0B5FA5"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:layout_marginTop="20dp">

            <TextView
                android:id="@+id/onTimeRateTextView"
                android:layout_width="0dp"
                android:layout_height="95dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                android:background="#D1D8E2"
                android:gravity="center"
                android:textColor="#0B5FA5"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/taskDoneTextView"
                android:layout_width="0dp"
                android:layout_height="95dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                android:background="#D1D8E2"
                android:gravity="center"
                android:textColor="#0B5FA5"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/overdueTextView"
                android:layout_width="0dp"
                android:layout_height="95dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                android:background="#D1D8E2"
                android:gravity="center"
                android:textColor="#0B5FA5"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/upcomingTextView"
                android:layout_width="0dp"
                android:layout_height="95dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                android:background="#D1D8E2"
                android:gravity="center"
                android:textColor="#0B5FA5"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/productivityTextView"
                android:layout_width="0dp"
                android:layout_height="95dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                android:background="#D1D8E2"
                android:gravity="center"
                android:textColor="#0B5FA5"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/studyHoursTextView"
                android:layout_width="0dp"
                android:layout_height="95dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                android:background="#D1D8E2"
                android:gravity="center"
                android:textColor="#0B5FA5"
                android:textSize="18sp" />
        </GridLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grade Impact Projection"
            android:textColor="#0B5FA5"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/pieChart"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tasks Completed This Week"
            android:textColor="#0B5FA5"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/previousAnalyticsWeekButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Previous Week" />

            <Button
                android:id="@+id/nextAnalyticsWeekButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Next Week" />
        </LinearLayout>

        <TextView
            android:id="@+id/analyticsWeekRangeTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#0B5FA5"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="6dp" />

        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/barChart"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/upcomingDeadlineTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#DDE6F2"
            android:padding="16dp"
            android:textColor="#0B5FA5"
            android:textSize="16sp"
            android:layout_marginTop="20dp" />

    </LinearLayout>
</ScrollView>