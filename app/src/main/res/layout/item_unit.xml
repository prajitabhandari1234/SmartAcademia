<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/unitCardLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="#DDE6F2"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/unitCodeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#0B5FA5"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/unitNameTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#111111"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/unitAssignmentCountTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#111111"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/unitGradeSummaryTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#111111"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/unitStatusTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#0B5FA5"
        android:textSize="15sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/editUnitButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:text="@string/edit_unit_button"
        android:textAllCaps="false" />

</LinearLayout>