<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF4FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greetingTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/good_morning_student"
                    android:textColor="#0B5FA5"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dateTimeTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#0B5FA5"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/profileButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile"
                    android:textAllCaps="false"/>

                <Button
                    android:id="@+id/logoutButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Logout"
                    android:textAllCaps="false"/>
            </LinearLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:columnCount="2">

            <TextView
                android:id="@+id/overdueCardTextView"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                android:background="#F7B6C2"
                android:gravity="center"
                android:text="@string/default_overdue_card"
                android:textColor="#111111"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/dueTodayCardTextView"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                android:background="#FFD7B5"
                android:gravity="center"
                android:text="@string/default_due_today_card"
                android:textColor="#111111"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/thisWeekCardTextView"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                android:background="#BDE7FF"
                android:gravity="center"
                android:text="@string/default_this_week_card"
                android:textColor="#111111"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/completedCardTextView"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                android:background="#C8E6C9"
                android:gravity="center"
                android:text="@string/default_completed_card"
                android:textColor="#111111"
                android:textSize="15sp" />
        </GridLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="My Academic Progress"
            android:textColor="#0B5FA5"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/unitSummaryTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#DDE6F2"
            android:padding="16dp"
            android:text="Loading units..."
            android:textColor="#111111"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/todays_study_plan"
            android:textColor="#0B5FA5"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/studyPlanTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#DDEEFF"
            android:minHeight="140dp"
            android:padding="16dp"
            android:text="@string/no_tasks"
            android:textColor="#111111"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/upcoming_deadlines"
            android:textColor="#0B5FA5"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/upcomingDeadlinesTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#DDE6F2"
            android:minHeight="100dp"
            android:padding="16dp"
            android:text="@string/no_upcoming_deadlines"
            android:textColor="#111111"
            android:textSize="15sp" />

        <Button
            android:id="@+id/enableAutoReminderButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:text="@string/enable_four_hour_reminders"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>